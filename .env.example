# copy to .env — loaded by python-dotenv. Keep comments on their own line:
# an inline "# comment" after a value is read as part of the value.
# Gemini Live (agent), Gemini Flash (captioner, VLM verify)
GOOGLE_API_KEY=
# OpenAI Realtime (agent), gpt-4o (judge, prompt generation)
OPENAI_API_KEY=
# claude-sonnet-4-6 (second judge)
ANTHROPIC_API_KEY=
# NVIDIA gated dataset snapshot; publishing to HF
HF_TOKEN=
# optional ASR backend
DEEPGRAM_API_KEY=
# WS6 avatar providers
TAVUS_API_KEY=
ANAM_API_KEY=
# HeyGen LiveAvatar key (app.liveavatar.com) — NOT the HeyGen platform key; HEYGEN_SANDBOX=1 renders the free sandbox avatar only
HEYGEN_API_KEY=
HEYGEN_SANDBOX=0
